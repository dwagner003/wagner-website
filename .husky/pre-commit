#!/bin/sh

echo "🔍 Running pre-commit checks..."

# Lint staged files
echo "📝 Linting..."
npx lint-staged
if [ $? -ne 0 ]; then
  echo "❌ Lint failed"
  exit 1
fi

# Type check
echo "🔷 Type checking..."
npx tsc -b --noEmit 2>&1
if [ $? -ne 0 ]; then
  echo "❌ Type check failed"
  exit 1
fi

# Unit tests
echo "🧪 Running unit tests..."
npm test
if [ $? -ne 0 ]; then
  echo "❌ Unit tests failed"
  exit 1
fi

# E2E tests (headless, chromium only for speed)
echo "🎭 Running e2e tests..."
npm run test:e2e -- --project=chromium
if [ $? -ne 0 ]; then
  echo "❌ E2E tests failed"
  exit 1
fi

# Bundle size check
echo "📦 Checking bundle size..."
npm run build -- --logLevel silent 2>&1
JS_SIZE=$(du -sk dist/assets/*.js | awk '{sum+=$1} END {print sum}')
if [ "$JS_SIZE" -gt 650 ]; then
  echo "❌ JS bundle size (${JS_SIZE}KB) exceeds 650KB limit"
  exit 1
fi
echo "   JS bundle: ${JS_SIZE}KB (limit: 650KB)"

echo "✅ All checks passed!"
