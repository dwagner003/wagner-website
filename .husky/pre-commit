#!/bin/sh

echo "🔍 Running pre-commit checks..."

# Lint staged files
echo "📝 Linting..."
npx lint-staged
if [ $? -ne 0 ]; then
  echo "❌ Lint failed"
  exit 1
fi

# Type check
echo "🔷 Type checking..."
npx tsc -b --noEmit 2>&1
if [ $? -ne 0 ]; then
  echo "❌ Type check failed"
  exit 1
fi

# Unit tests
echo "🧪 Running unit tests..."
npm test
if [ $? -ne 0 ]; then
  echo "❌ Unit tests failed"
  exit 1
fi

# E2E tests (headless, chromium only for speed)
echo "🎭 Running e2e tests..."
npm run test:e2e -- --project=chromium
if [ $? -ne 0 ]; then
  echo "❌ E2E tests failed"
  exit 1
fi

echo "✅ All checks passed!"
